{
	"name": "icon-studio",
	"version": "1.0.0",
	"description": "VSCode-like Icon Editor IDE",
	"main": "dist/main.js",
	"scripts": {
		"start": "concurrently \"npm run build:main -- --watch\" \"npm run build:renderer -- --watch\" \"wait-on dist/main.js && electron .\"",
		"build": "npm run build:main && npm run build:renderer",
		"build:main": "webpack --config webpack.main.config.js",
		"build:renderer": "webpack --config webpack.renderer.config.js",
		"package": "npm run build && electron-builder",
		"dev": "concurrently --kill-others --success first \"npm run build:main -- --watch\" \"npm run build:renderer -- --watch\" \"wait-on dist/main.js dist/renderer.js && electron .\"",
		"clean": "rimraf dist node_modules/.cache",
		"clean:dev": "npm run clean && npm run dev"
	},
	"keywords": [
		"icon",
		"editor",
		"electron",
		"react",
		"typescript"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.10.0",
		"@types/react": "^18.2.42",
		"@types/react-dom": "^18.2.17",
		"concurrently": "^8.2.2",
		"css-loader": "^6.8.1",
		"electron": "^28.0.0",
		"electron-builder": "^24.9.1",
		"html-webpack-plugin": "^5.5.4",
		"style-loader": "^3.3.3",
		"ts-loader": "^9.5.1",
		"typescript": "^5.3.2",
		"wait-on": "^7.2.0",
		"webpack": "^5.89.0",
		"webpack-cli": "^5.1.4"
	},
	"dependencies": {
		"discord.js": "^14.14.1",
		"midjourney": "^6.1.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"build": {
		"appId": "com.iconstudio.app",
		"productName": "Icon Studio",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"package.json"
		],
		"win": {
			"target": "nsis"
		},
		"mac": {
			"target": "dmg"
		},
		"linux": {
			"target": "AppImage"
		}
	}
}
